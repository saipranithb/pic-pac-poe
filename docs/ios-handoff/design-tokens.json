  "board": {
    "aspectRatio": 1,
    "outerRadiusDp": 24,
    "contentInsetDp": 12,
    "gridSize": 3,
    "gapDp": 6,
    "cellSideFormula": "(boardSide - 2*12dp - 2*6dp)/3",
    "indexFormula": "row*3+column, zero-based; accessibility announces one-based",
    "cellCenterFormula": "12dp + column*(cellSide+6dp)+cellSide/2; same for row",
    "drawOrder": [
      {
        "layer": "board shadow",
        "color": "shadow",
        "alpha": 0.24,
        "offsetDp": [
          0,
          3
        ],
        "blurDp": 0,
        "radiusDp": 24
      },
      {
        "layer": "body",
        "gradient": [
          "surfaceRaised",
          "surface"
        ],
        "gradientDirection": "vertical"
      },
      {
        "layer": "border",
        "color": "border",
        "strokeDp": 1,
        "insetDp": 0.5,
        "sizeReductionDp": 1,
        "radiusDp": 24
      },
      {
        "layer": "top highlight",
        "color": "highlight",
        "alpha": 0.35,
        "fromDp": [
          24,
          1
        ],
        "to": "(width-24dp,1dp)",
        "strokeDp": 1,
        "cap": "round"
      },
      {
        "layer": "nine wells",
        "description": "fixed geometry below"
      },
      {
        "layer": "winning line",
        "description": "inside board content inset; recess 5dp stroke then text 2dp stroke, round caps, through centers of first/third winning cells"
      }
    ],
    "well": {
      "radiusFormula": "min(18dp, cellSide*0.19)",
      "drawOrder": [
        {
          "layer": "face",
          "gradient": [
            "recess",
            "surface"
          ],
          "gradientDirection": "vertical"
        },
        {
          "layer": "rim",
          "color": "border",
          "strokeDp": 1,
          "insetDp": 0.5,
          "sizeReductionDp": 1
        },
        {
          "layer": "top inset edge",
          "color": "shadow",
          "alpha": 0.32,
          "pressedAlpha": 0.65,
          "from": "(radius,2dp)",
          "to": "(width-radius,2dp)",
          "strokeDp": 2,
          "cap": "round"
        },
        {
          "layer": "pressed wash",
          "condition": "pressed and enabled",
          "color": "border",
          "alpha": 0.16
        },
        {
          "layer": "AI target or winning outline",
          "color": "focus",
          "insetDp": 3,
          "strokeDp": 2
        },
        {
          "layer": "additional AI target outline",
          "color": "focus",
